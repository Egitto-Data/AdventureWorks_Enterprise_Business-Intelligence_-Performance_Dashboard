		measure 'Revenue KPI Card SVG' =
				
				VAR CurrentVal = [Total Revenue]
				VAR PreviousVal = [Previous Month Revenue]
				VAR PctOfPM = DIVIDE(CurrentVal, PreviousVal, 0)
				VAR GaugePct = MIN(1.0, MAX(0.0, PctOfPM))
				
				-- Performance Status (Good = Green Gradient, Bad = Red Gradient)
				VAR IsGood = CurrentVal >= PreviousVal
				VAR GradStart = IF(IsGood, "%23059669", "%23DC2626")
				VAR GradEnd   = IF(IsGood, "%2310B981", "%23EF4444")
				VAR GradID    = "gradRev"
				
				-- Gauge mask calculations (Bar length = 180px, starting at X=20)
				VAR FillWidth = INT(180 * GaugePct)
				VAR MaskWidth = 180 - FillWidth
				VAR MaskX     = 20 + FillWidth
				
				RETURN
				"data:image/svg+xml;utf8," &
				"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 240 130' overflow='visible'>" &
				
				  "<defs>" &
				    "-- Card Drop Shadow --" &
				    "<filter id='cardShadow' x='-10%' y='-10%' width='130%' height='130%'>" &
				      "<feDropShadow dx='1' dy='2' stdDeviation='3' flood-color='%23000000' flood-opacity='0.12'/>" &
				    "</filter>" &
				
				    "-- Blue to Cyan Bar Fill Gradient --" &
				    "<linearGradient id='barLinear' x1='0%' y1='0%' x2='100%' y2='0%'>" &
				      "<stop offset='0%' stop-color='%230284c7'/>" &
				      "<stop offset='100%' stop-color='%2338bdf8'/>" &
				    "</linearGradient>" &
				
				    "-- KPI Text Dynamic Scale Gradient --" &
				    "<linearGradient id='" & GradID & "' x1='0%' y1='0%' x2='100%' y2='0%'>" &
				      "<stop offset='0%' stop-color='" & GradStart & "'/>" &
				      "<stop offset='100%' stop-color='" & GradEnd & "'/>" &
				    "</linearGradient>" &
				
				    "<clipPath id='clip-rev'>" &
				      "<rect x='" & MaskX & "' y='85' width='" & MaskWidth & "' height='18' />" &
				    "</clipPath>" &
				  "</defs>" &
				
				  "-- Card Background Outline --" &
				  "<rect x='6' y='6' rx='6' ry='6' width='228' height='118' fill='white' stroke='%23E5E7EB' stroke-width='1' filter='url(#cardShadow)'/>" &
				
				  "-- Title --" &
				  "<text text-anchor='start' font-size='11pt' font-family='Segoe UI, sans-serif' x='18' y='28' fill='#1F2937'>Monthly Revenue</text>" &
				
				  "-- Main KPI Value with Gradient Fill --" &
				  "<text text-anchor='start' font-weight='bold' font-size='24pt' font-family='Segoe UI, sans-serif' x='18' y='68' fill='url(#" & GradID & ")'>" & FORMAT(CurrentVal, "$#,##0") & "</text>" &
				
				  "-- Last Month Box --" &
				  "<rect x='118' y='42' rx='3' ry='3' width='102' height='28' fill='%23EEF2FF'></rect>" &
				  "<text text-anchor='start' font-size='9pt' font-family='Segoe UI, sans-serif' x='125' y='60' fill='#1F2937'>Last Month: " & FORMAT(PreviousVal, "$#,##0") & "</text>" &
				
				  "-- Progress Bar Track & Fill --" &
				  "<rect id='track' x='20' y='85' rx='9' ry='9' width='180' height='18' fill='%23D1D5DB'></rect>" &
				  "<rect id='fill' x='20' y='85' rx='9' ry='9' width='180' height='18' fill='url(#barLinear)'></rect>" &
				  "<rect id='mask' x='20' y='85' rx='9' ry='9' width='180' height='18' fill='%23D1D5DB' clip-path='url(#clip-rev)'></rect>" &
				
				"</svg>"
			lineageTag: 19027b21-bd8c-4cda-b4b7-0e9e0be30867

		measure 'Adjusted Price' = [Average Retail Price] * (1 + 'Price Adjustment (%)'[Price Adjustment (%) Value])
